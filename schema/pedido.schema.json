{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pbms01/biblioteca_mourax/blob/main/schema/pedido.schema.json",
  "title": "Pedido de registro aprovado (chave 1)",
  "description": "Arquivo pedidos/<AAAAMMDDTHHMMSSZ>.json, gravado pelo agente depois da aprovação expressa do titular e enviado numa branch pedido/<AAAAMMDDTHHMMSSZ>. Contém só os itens aprovados. Integra a cadeia de custódia.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao_schema",
    "id_pedido",
    "criado_em",
    "modo",
    "aprovacao",
    "origem",
    "itens"
  ],
  "properties": {
    "versao_schema": { "const": 1 },
    "id_pedido": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z$",
      "description": "Igual ao nome do arquivo e ao sufixo da branch."
    },
    "criado_em": { "$ref": "#/$defs/data_hora" },
    "modo": {
      "enum": ["conversa", "acervo"],
      "description": "conversa: /fontes; acervo: /fontes acervo."
    },
    "aprovacao": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aprovado_por", "aprovado_em", "canal"],
      "properties": {
        "aprovado_por": { "type": "string", "minLength": 1 },
        "aprovado_em": { "$ref": "#/$defs/data_hora" },
        "canal": { "enum": ["conversa", "planilha_revisao"] },
        "manifestacao": {
          "type": "string",
          "minLength": 1,
          "description": "Transcrição literal da manifestação de aprovação do titular."
        }
      }
    },
    "origem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id_opaco", "data"],
      "description": "A correspondência entre o identificador opaco e a conversa ou o lote fica no cofre privado.",
      "properties": {
        "id_opaco": { "type": "string", "pattern": "^[0-9a-f]{16,64}$" },
        "data": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "itens": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "data_hora": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "url": { "type": "string", "pattern": "^https?://\\S+$" },
    "dominio": {
      "enum": ["normas", "julgados", "doutrina", "ciencia", "tecnica", "web"]
    },
    "categoria_autoral": {
      "enum": ["ato_oficial", "dominio_publico", "licenca_aberta", "protegida"]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n",
        "obra",
        "referencia",
        "urls_candidatas",
        "grau_proposto",
        "regime_proposto"
      ],
      "properties": {
        "n": { "type": "integer", "minimum": 1 },
        "obra": {
          "type": "object",
          "additionalProperties": false,
          "required": ["titulo", "dominio", "tipo"],
          "properties": {
            "titulo": { "type": "string", "minLength": 1 },
            "autoria": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "dominio": { "$ref": "#/$defs/dominio" },
            "tipo": { "type": "string", "pattern": "^[a-z0-9_]+$" },
            "identificador": {
              "type": "string",
              "minLength": 1,
              "description": "URN LEX, DOI, arXiv com versão, ISBN ou URL canônica."
            },
            "id_existente": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "description": "Preenchido quando a obra já está no catálogo: gera nova captura ou só nova ocorrência."
            }
          }
        },
        "referencia": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tipologia", "autoria_trecho", "origem_trecho"],
          "properties": {
            "tipologia": {
              "enum": ["mencao", "citacao_literal", "parafrase", "alusao", "dispositivo"]
            },
            "trecho": {
              "type": "string",
              "minLength": 1,
              "description": "Como apareceu na conversa, sem correção."
            },
            "dispositivo": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$",
              "description": "Âncora pretendida, por exemplo art-46-iii."
            },
            "autoria_trecho": { "enum": ["usuario", "assistente", "anexo"] },
            "origem_trecho": { "enum": ["transcrito_do_contexto", "exportacao"] }
          },
          "allOf": [
            {
              "if": { "properties": { "tipologia": { "const": "citacao_literal" } } },
              "then": { "required": ["trecho"] }
            },
            {
              "if": { "properties": { "tipologia": { "const": "dispositivo" } } },
              "then": { "required": ["dispositivo"] }
            }
          ]
        },
        "urls_candidatas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "papel"],
            "properties": {
              "url": { "$ref": "#/$defs/url" },
              "papel": { "enum": ["original", "compilada", "espelho", "licenca"] }
            }
          }
        },
        "grau_proposto": { "enum": [1, 2, 3] },
        "regime_proposto": {
          "type": "object",
          "additionalProperties": false,
          "required": ["categoria", "fundamento", "armazenamento"],
          "properties": {
            "categoria": { "$ref": "#/$defs/categoria_autoral" },
            "fundamento": { "type": "string", "minLength": 1 },
            "licenca": { "type": "string", "minLength": 1 },
            "armazenamento": { "enum": ["integral", "trecho"] }
          },
          "allOf": [
            {
              "if": { "properties": { "categoria": { "const": "protegida" } } },
              "then": { "properties": { "armazenamento": { "const": "trecho" } } }
            },
            {
              "if": { "properties": { "categoria": { "const": "licenca_aberta" } } },
              "then": { "required": ["licenca"] }
            }
          ]
        }
      }
    }
  }
}
